# =============================================================================
# Cocoloco API — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control — it contains sensitive secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Runtime environment: development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection URL using asyncpg driver (async I/O)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/cocoloco_db

# -----------------------------------------------------------------------------
# Clerk Authentication (RS256 JWKS)
# -----------------------------------------------------------------------------
# JWKS endpoint for verifying Clerk-issued JWT tokens
# Find it at: https://dashboard.clerk.com → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://<your-clerk-frontend-api>/.well-known/jwks.json
