            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"Returns error detail message\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property(\"detail\");",
