    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "YOUR_USER_CLERK_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "YOUR_ADMIN_CLERK_TOKEN_HERE",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "f66fe585-6512-45f7-b66f-6bdbe11b146e",
      "type": "string"
    },
    {
      "key": "created_product_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "a59dccf9-d767-44ff-8be0-335e3bdbeffd",
      "type": "string"
    },
    {
      "key": "target_user_id",
