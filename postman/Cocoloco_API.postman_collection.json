  "item": [
    {
      "name": "0. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Service status is ok\", function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.status).to.eql(\"ok\");",
              "    pm.expect(data.service).to.eql(\"cocoloco-api\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "Liveness probe returning HTTP 200 with service status."
      }
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Sync User (POST /auth/sync)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns synchronized user object\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property(\"id\");",
                  "    pm.expect(data).to.have.property(\"clerk_id\");",
                  "    pm.expect(data).to.have.property(\"email\");",
                  "    pm.collectionVariables.set(\"user_id\", data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Hien Nguyen\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/sync",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "sync"]
            },
            "description": "Upserts the authenticated Clerk user into the local PostgreSQL database."
          }
        }
      ]
    },
