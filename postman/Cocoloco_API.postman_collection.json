              "raw": "{{base_url}}/api/v1/products/00000000-0000-0000-0000-000000000000",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "00000000-0000-0000-0000-000000000000"]
            },
            "description": "Negative Test: Looking up a non-existent UUID must return HTTP 404."
          }
        },
        {
          "name": "422 - Validation Error (Quantity <= 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test(\"Pydantic validation error details provided\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.have.property(\"detail\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
