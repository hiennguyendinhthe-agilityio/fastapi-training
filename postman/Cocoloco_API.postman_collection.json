{
  "info": {
    "_postman_id": "cocoloco-api-collection-v1",
    "name": "Cocoloco Food & Coffee Ordering API",
    "description": "Comprehensive Postman collection for Cocoloco API (FastAPI, PostgreSQL, Clerk RS256 JWKS). Includes automated assertions and dynamic variable chaining for Auth, Users, Products, and Orders with 2-Tier RBAC.",
